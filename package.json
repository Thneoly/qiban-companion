{
  "name": "companion-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/desktop",
    "packages/contracts",
    "apps/mobile-web"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @companion/desktop",
    "desktop": "npm run tauri --workspace @companion/desktop -- dev",
    "build": "npm run build --workspace @companion/desktop",
    "build:desktop": "npm run tauri --workspace @companion/desktop -- build --no-bundle",
    "typecheck": "tsc --noEmit -p apps/desktop/tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build && npm run test:mobile",
    "rust:check": "cargo check --workspace --locked",
    "rust:test": "cargo test --workspace --locked",
    "test:browser": "npm run test:browser --workspace @companion/desktop",
    "verify:docs": "node scripts/verification/verify-docs.cjs && node scripts/verification/verify-plan.cjs",
    "verify:prototype": "node scripts/verification/verify-prototype.cjs",
    "build:installer": "npm run build:installer --workspace @companion/desktop --",
    "coordinator": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/coordinator/scripts/start.ps1",
    "coordinator:configure": "npm run coordinator -- -Configure",
    "coordinator:check": "npm run coordinator -- -Check",
    "test:coordinator-launcher": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/coordinator/scripts/test-start.ps1",
    "coordinator:configure:qq": "npm run coordinator -- -Configure -Provider qq",
    "coordinator:configure:163": "npm run coordinator -- -Configure -Provider 163",
    "coordinator:login": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/coordinator/scripts/login.ps1",
    "test:coordinator-login": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/coordinator/scripts/test-login.ps1 && node --test apps/coordinator/scripts/test-login-http.mjs",
    "build:mobile": "npm run build --workspace @companion/mobile-web",
    "mobile": "npm run build:mobile && npm run start --workspace @companion/mobile-web",
    "mobile:https": "npm run build:mobile && npm run https --workspace @companion/mobile-web",
    "test:mobile": "npm run build:mobile && npm test --workspace @companion/mobile-web",
    "test:mobile:integration": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/mobile-web/scripts/test-integration.ps1"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
