{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local main window only; no shell, filesystem plugin or remote origin permissions.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-voice-probe",
    "allow-voice-cancel",
    "allow-voice-key-set",
    "allow-get-runtime-info",
    "allow-list-tasks",
    "allow-create-task",
    "allow-cancel-task",
    "allow-pet-action",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-model-settings-get",
    "allow-model-settings-save",
    "allow-model-key-set",
    "allow-model-key-delete",
    "allow-memory-list",
    "allow-memory-mutate",
    "allow-memory-export",
    "allow-chat-context-preview",
    "allow-memory-policy-set",
    "allow-execution-list",
    "allow-execution-prepare",
    "allow-execution-detail",
    "allow-execution-cancel",
    "allow-execution-confirm",
    "allow-execution-reconcile",
    "allow-execution-result"
  ]
}
